    "title": "우리동네 동구 맛집 & 카페 아카이브 실무 웹앱 (실시간 검색 & 좋아요)",
    "fileData": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>우리동네 동구 맛지도</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-amber-50/40 text-slate-800 font-sans min-h-screen flex flex-col justify-between\">\n  <nav class=\"bg-white/95 sticky top-0 z-20 border-b border-amber-200 px-4 sm:px-6 py-3.5 flex items-center justify-between\">\n    <div class=\"text-base sm:text-lg font-black text-amber-950 flex items-center gap-2\">\n      <span class=\"text-2xl\">🍽️</span> 우리동네 동구 맛지도\n    </div>\n    <span class=\"px-2.5 py-1 rounded-full bg-amber-200 text-amber-950 text-xs font-bold\">\n      대전 동구 추천 명소 6선\n    </span>\n  </nav>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-6 w-full space-y-6\">\n    <div class=\"space-y-3\">\n      <input type=\"text\" id=\"eatsSearch\" oninput=\"searchEats(this.value)\" placeholder=\"식당 이름, 대표 메뉴 검색 (예: 칼국수, 카페)...\" class=\"w-full px-4 py-2.5 text-xs sm:text-sm rounded-2xl border border-amber-200 bg-white shadow-2xs\">\n      <div class=\"flex items-center gap-1.5 overflow-x-auto pb-1 text-xs font-bold\" id=\"eatsCatFilter\">\n        <button onclick=\"filterEats('전체')\" class=\"px-3 py-1.5 rounded-xl bg-amber-900 text-white shrink-0\">전체보기</button>\n        <button onclick=\"filterEats('소제동 카페')\" class=\"px-3 py-1.5 rounded-xl bg-white border border-amber-200 text-slate-700 hover:bg-amber-50 shrink-0\">☕ 소제동 카페</button>\n        <button onclick=\"filterEats('전통 노포')\" class=\"px-3 py-1.5 rounded-xl bg-white border border-amber-200 text-slate-700 hover:bg-amber-50 shrink-0\">🍜 전통 노포/칼국수</button>\n        <button onclick=\"filterEats('중앙시장')\" class=\"px-3 py-1.5 rounded-xl bg-white border border-amber-200 text-slate-700 hover:bg-amber-50 shrink-0\">🍲 중앙시장 명물</button>\n      </div>\n    </div>\n\n    <div id=\"eatsGrid\" class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n    </div>\n  </main>\n\n  <footer class=\"bg-amber-950 text-amber-200/80 py-4 px-4 text-center text-xs\">\n    <p>동구평생학습관 4회차 동네 맛집 아카이브 웹앱 실습작품</p>\n  </footer>\n\n  <script>\n    const eats = [\n      { id: 1, name: '소제동 풍뉴가', cat: '소제동 카페', menu: '대나무숲 수제 티 칵테일 & 차', loc: '대전 동구 소제동 철도관사촌', rating: 4.9, icon: '🎋', likes: 42 },\n      { id: 2, name: '신도칼국수 본점', cat: '전통 노포', menu: '60년 전통 들깨 칼국수 & 수육', loc: '대전 동구 정동 대전역 앞', rating: 4.8, icon: '🍜', likes: 65 },\n      { id: 3, name: '개천식당', cat: '중앙시장', menu: '이북식 평양 만두국 & 튀김만두', loc: '대전 동구 원동 중앙시장 먹자골목', rating: 4.7, icon: '🥟', likes: 38 },\n      { id: 4, name: '베리도넛', cat: '소제동 카페', menu: '글레이즈드 수제 크림 도넛', loc: '대전 동구 수향길 골목', rating: 4.9, icon: '🍩', likes: 53 },\n      { id: 5, name: '광천순대', cat: '전통 노포', menu: '얼큰 순대국밥 & 막창순대', loc: '대전 동구 인동 골목', rating: 4.8, icon: '🍲', likes: 47 },\n      { id: 6, name: '이모네 전집', cat: '중앙시장', menu: '바삭 모듬전 & 막걸리', loc: '대전 동구 중앙시장 3번 게이트', rating: 4.6, icon: '🥞', likes: 29 }\n    ];\n    let curCat = '전체';\n    let curQ = '';\n\n    function renderEats() {\n      const grid = document.getElementById('eatsGrid');\n      let filtered = eats;\n      if (curCat !== '전체') filtered = filtered.filter(e => e.cat === curCat);\n      if (curQ) filtered = filtered.filter(e => e.name.includes(curQ) || e.menu.includes(curQ));\n\n      grid.innerHTML = filtered.map(e => `\n        <div class=\"bg-white rounded-2xl p-4 border border-amber-100 shadow-2xs space-y-3 flex flex-col justify-between\">\n          <div>\n            <div class=\"flex items-center justify-between text-xs\">\n              <span class=\"px-2 py-0.5 rounded-md bg-amber-100 text-amber-900 font-bold text-[10px]\">${e.cat}</span>\n              <span class=\"text-amber-600 font-bold\">⭐ ${e.rating}</span>\n            </div>\n            <div class=\"flex items-center gap-3 mt-2\">\n              <span class=\"text-4xl shrink-0\">${e.icon}</span>\n              <div>\n                <h4 class=\"font-black text-base text-slate-900\">${e.name}</h4>\n                <p class=\"text-xs text-amber-900 font-medium\">${e.menu}</p>\n                <p class=\"text-[11px] text-slate-400 mt-0.5\">${e.loc}</p>\n              </div>\n            </div>\n          </div>\n          <div class=\"pt-2 border-t border-slate-100 flex items-center justify-between text-xs\">\n            <button onclick=\"likeEat(${e.id})\" class=\"text-rose-500 font-bold flex items-center gap-1 hover:scale-105 transition\">\n              ❤️ <span id=\"like-${e.id}\">${e.likes}</span>\n            </button>\n            <button onclick=\"alert('${e.name}\\n대표메뉴: ${e.menu}\\n위치: ${e.loc}\\n동구평생학습관 추천 명소입니다!')\" class=\"px-3 py-1 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-950 font-bold text-[11px]\">\n              상세보기\n            </button>\n          </div>\n        </div>\n      `).join('');\n    }\n\n    function likeEat(id) {\n      const item = eats.find(e => e.id === id);\n      if (item) {\n        item.likes++;\n        document.getElementById('like-' + id).innerText = item.likes;\n      }\n    }\n\n    function filterEats(c) {\n      curCat = c;\n      document.querySelectorAll('#eatsCatFilter button').forEach(b => {\n        b.className = b.innerText.includes(c) ? 'px-3 py-1.5 rounded-xl bg-amber-900 text-white shrink-0' : 'px-3 py-1.5 rounded-xl bg-white border border-amber-200 text-slate-700 hover:bg-amber-50 shrink-0';\n      });\n      renderEats();\n    }\n\n    function searchEats(q) {\n      curQ = q.trim();\n      renderEats();\n    }\n\n    renderEats();\n  </script>\n</body>\n</html>",
